{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=tictactoe;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/tictactoe-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "dev-only-jwt-signing-key-change-me-please-0123456789abcdef",
    "Issuer": "tic-tac-toe-api",
    "Audience": "tic-tac-toe-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": "http://localhost:4200,http://localhost:8080"
  },
  "GameRules": {
    "MoveTimeoutSeconds": 60
  }
}